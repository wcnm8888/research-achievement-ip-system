generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DepartmentStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  PENDING_ACTIVATION
  DISABLED
  ARCHIVED
}

enum CredentialStatus {
  ACTIVE
  DISABLED
}

enum AccountLifecycleTokenPurpose {
  INVITE_ACCEPT
  PASSWORD_RESET_SELF
  PASSWORD_RESET_ADMIN
}

enum AccountLifecycleTokenStatus {
  ACTIVE
  USED
  REVOKED
}

enum AccountLifecycleDeliveryChannel {
  EMAIL
}

enum AccountLifecycleDeliveryStatus {
  PENDING
  QUEUED
  SENT
  FAILED
  SUPPRESSED
}

enum RoleStatus {
  ACTIVE
  ARCHIVED
}

enum PermissionStatus {
  ACTIVE
  ARCHIVED
}

enum UserRoleScopeType {
  GLOBAL
  DEPARTMENT
}

enum ResourceType {
  ACHIEVEMENT
  ATTACHMENT
  FEE_RECORD
  WORKFLOW_INSTANCE
  AUDIT_LOG
}

enum GranteeType {
  USER
  ROLE
  DEPARTMENT
}

enum GrantType {
  SECRET_READ
  SECRET_WRITE
  ATTACHMENT_DOWNLOAD
  AUDIT_READ
}

enum GrantStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum AchievementType {
  PAPER
  PATENT
  SOFTWARE_COPYRIGHT
}

enum AchievementStatus {
  DRAFT
  PENDING_DEPARTMENT_REVIEW
  DEPARTMENT_REJECTED
  PENDING_ARCHIVE
  ARCHIVED
  VOIDED
}

enum SecretLevel {
  PUBLIC
  INTERNAL
  SECRET
  CONFIDENTIAL
}

enum ContributorType {
  AUTHOR
  INVENTOR
  COPYRIGHT_OWNER
}

enum ContributorRole {
  FIRST_AUTHOR
  CORRESPONDING_AUTHOR
  PRIMARY_INVENTOR
  PARTICIPANT
  OWNER
  OTHER
}

enum PatentType {
  INVENTION
  UTILITY_MODEL
  DESIGN
  NATIONAL_DEFENSE
  OTHER
}

enum PatentLegalStatus {
  PENDING
  GRANTED
  REJECTED
  EXPIRED
  TERMINATED
  TRANSFERRED
  UNKNOWN
}

enum SoftwareType {
  APPLICATION
  SYSTEM
  TOOL
  EMBEDDED
  OTHER
}

enum WorkflowTargetType {
  ACHIEVEMENT
  FEE_RECORD
}

enum WorkflowInstanceStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WorkflowTaskStatus {
  PENDING
  CLAIMED
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkflowActionType {
  SUBMIT
  APPROVE
  REJECT
  ARCHIVE
  VOID
  CANCEL
}

enum FeeType {
  PATENT_APPLICATION
  PATENT_ANNUAL
  SOFTWARE_COPYRIGHT
  AGENCY
  OTHER
}

enum FundSource {
  PROJECT
  DEPARTMENT
  INSTITUTE
  OTHER
}

enum PayStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum FeeReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeeReviewHistoryAction {
  APPROVE
  REJECT
}

enum ReminderTargetType {
  FEE_RECORD
}

enum ReminderLevel {
  DAYS_30
  DAYS_15
  DAYS_7
  OVERDUE
}

enum ReminderStatus {
  PENDING
  SENT
  CONFIRMED
  CANCELLED
  FAILED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  READ
  FAILED
  CANCELLED
}

enum AttachmentRelationType {
  ACHIEVEMENT
  FEE_RECORD
  WORKFLOW_ACTION
}

enum AttachmentStatus {
  ACTIVE
  ARCHIVED
  BLOCKED
}

enum AuditActionType {
  CREATE
  UPDATE
  SUBMIT
  APPROVE
  REJECT
  ARCHIVE
  VOID
  UPLOAD_ATTACHMENT
  DOWNLOAD_ATTACHMENT
  MARK_FEE_PAID
  CONFIRM_REMINDER
  CONFIG_UPDATE
  BOOTSTRAP_ADMIN
  LOGIN
  LOGIN_FAILED
  LOGOUT
  SESSION_REVOKED
  AUTH_ME_DENIED
  INVITE_CREATED
  INVITE_RESENT
  INVITE_ACCEPTED
  INVITE_REVOKED
  PASSWORD_RESET_REQUESTED_SELF
  PASSWORD_RESET_REQUESTED_ADMIN
  PASSWORD_RESET_CONFIRMED
  PASSWORD_RESET_REVOKED
  PASSWORD_RESET_FAILED
  CREDENTIAL_CHANGED
}

enum ApiIntegrationProvider {
  DOI
  EMAIL
  HR
  FINANCE
  PATENT
  STORAGE
  SEARCH
  OTHER
}

enum ApiCallStatus {
  SUCCESS
  FAILED
  TIMEOUT
  RETRIED
  SKIPPED
}

enum ImportFamily {
  DEPARTMENT
  USER_ACCOUNT
  ACHIEVEMENT
}

enum ImportMode {
  CREATE_ONLY
  CREATE_ONLY_PENDING_NO_CREDENTIAL
  CREATE_DRAFT_ONLY
}

enum ImportJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  REJECTED
}

enum ImportRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  REJECTED
}

enum ImportRunTrigger {
  INITIAL_SUBMIT
  RETRY_AFTER_FAILED
  OPERATOR_REPLAY_CHECK
}

enum ImportFailureStage {
  ACCEPTANCE
  VALIDATION
  TRANSACTION
  RESPONSE
  POST_APPLY_RECONCILIATION
}

enum ImportJobItemPlannedAction {
  CREATE
  CREATE_PENDING_USER
  CREATE_DRAFT
  SKIP
  BLOCK
}

enum ImportJobItemStatus {
  PENDING
  APPLIED
  SKIPPED
  BLOCKED
  FAILED
}

enum ImportJobItemTargetType {
  DEPARTMENT
  USER
  ACHIEVEMENT
}

model Department {
  id         String           @id @default(uuid()) @db.Uuid
  code       String           @unique @db.VarChar(64)
  name       String           @db.VarChar(200)
  parentId   String?          @map("parent_id") @db.Uuid
  status     DepartmentStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  archivedAt DateTime?        @map("archived_at")

  parent         Department?   @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children       Department[]  @relation("DepartmentHierarchy")
  users          User[]
  userRoleScopes UserRole[]
  achievements   Achievement[]
  feeRecords     FeeRecord[]
  feeReviewHistory FeeReviewHistory[] @relation("FeeReviewHistoryDepartment")
  auditLogs      AuditLog[]    @relation("AuditDepartment")

  @@index([parentId])
  @@index([status])
  @@map("departments")
}

model User {
  id                   String     @id @default(uuid()) @db.Uuid
  email                String     @unique @db.VarChar(255)
  employeeNo           String?    @map("employee_no") @db.VarChar(64)
  employeeNoNormalized String?    @unique @map("employee_no_normalized") @db.VarChar(64)
  name                 String     @db.VarChar(120)
  departmentId         String     @map("department_id") @db.Uuid
  status               UserStatus @default(ACTIVE)
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  archivedAt           DateTime?  @map("archived_at")

  department            Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  credential            UserCredential?
  userRoles             UserRole[]
  ownedAchievements     Achievement[]            @relation("AchievementOwner")
  submittedAchievements Achievement[]            @relation("AchievementSubmitter")
  contributions         AchievementContributor[]
  assignedWorkflowTasks WorkflowTask[]           @relation("WorkflowTaskAssignee")
  workflowActions       WorkflowAction[]         @relation("WorkflowActionActor")
  reminderTasks         ReminderTask[]           @relation("ReminderReceiver")
  notifications         Notification[]           @relation("NotificationReceiver")
  uploadedAttachments   Attachment[]             @relation("AttachmentUploader")
  reviewedFeeRecords    FeeRecord[]              @relation("FeeReviewer")
  feeReviewHistory      FeeReviewHistory[]        @relation("FeeReviewHistoryReviewer")
  auditLogs             AuditLog[]               @relation("AuditActor")
  searchLogs            SearchLog[]
  sessions              UserSession[]
  loginAttempts         LoginAttempt[]
  accountLifecycleTokens        AccountLifecycleToken[] @relation("AccountLifecycleTokenTarget")
  createdAccountLifecycleTokens AccountLifecycleToken[] @relation("AccountLifecycleTokenCreator")

  @@index([departmentId])
  @@index([status])
  @@map("users")
}

model UserCredential {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @unique @map("user_id") @db.Uuid
  passwordHash      String           @map("password_hash") @db.VarChar(255)
  passwordUpdatedAt DateTime?        @map("password_updated_at")
  status            CredentialStatus @default(ACTIVE)
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  disabledAt        DateTime?        @map("disabled_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_credentials")
}

model UserSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  sessionHash     String    @unique @map("session_hash") @db.VarChar(255)
  createdAt       DateTime  @default(now()) @map("created_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  lastSeenAt      DateTime? @map("last_seen_at")
  userAgentHash   String?   @map("user_agent_hash") @db.VarChar(128)
  ipHash          String?   @map("ip_hash") @db.VarChar(128)
  createdByIpHash String?   @map("created_by_ip_hash") @db.VarChar(128)
  revokedReason   String?   @map("revoked_reason") @db.VarChar(120)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  emailHash     String   @map("email_hash") @db.VarChar(128)
  ipHash        String?  @map("ip_hash") @db.VarChar(128)
  success       Boolean  @default(false)
  failureReason String?  @map("failure_reason") @db.VarChar(120)
  userId        String?  @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([success, createdAt])
  @@index([userId, createdAt])
  @@map("login_attempts")
}

model AccountLifecycleToken {
  id                   String                          @id @default(uuid()) @db.Uuid
  purpose              AccountLifecycleTokenPurpose
  tokenHash            String                          @unique @map("token_hash") @db.VarChar(128)
  targetUserId         String?                         @map("target_user_id") @db.Uuid
  emailHash            String?                         @map("email_hash") @db.VarChar(128)
  status               AccountLifecycleTokenStatus     @default(ACTIVE)
  expiresAt            DateTime                        @map("expires_at")
  usedAt               DateTime?                       @map("used_at")
  revokedAt            DateTime?                       @map("revoked_at")
  revokedReason        String?                         @map("revoked_reason") @db.VarChar(500)
  createdByUserId      String?                         @map("created_by_user_id") @db.Uuid
  createdByIpHash      String?                         @map("created_by_ip_hash") @db.VarChar(128)
  createdUserAgentHash String?                         @map("created_user_agent_hash") @db.VarChar(128)
  deliveryChannel      AccountLifecycleDeliveryChannel? @map("delivery_channel")
  deliveryStatus       AccountLifecycleDeliveryStatus?  @map("delivery_status")
  deliveryAdapter      String?                         @map("delivery_adapter") @db.VarChar(64)
  auditCorrelationId   String?                         @map("audit_correlation_id") @db.VarChar(128)
  createdAt            DateTime                        @default(now()) @map("created_at")
  updatedAt            DateTime                        @updatedAt @map("updated_at")

  targetUser    User? @relation("AccountLifecycleTokenTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdByUser User? @relation("AccountLifecycleTokenCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([targetUserId, purpose, status])
  @@index([emailHash, purpose, status])
  @@index([status, expiresAt])
  @@index([createdByUserId])
  @@map("account_lifecycle_tokens")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(64)
  name        String     @db.VarChar(120)
  description String?    @db.Text
  status      RoleStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  archivedAt  DateTime?  @map("archived_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([status])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(120)
  resource    String           @db.VarChar(80)
  action      String           @db.VarChar(80)
  name        String           @db.VarChar(120)
  description String?          @db.Text
  status      PermissionStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@index([action])
  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  roleId       String            @map("role_id") @db.Uuid
  scopeType    UserRoleScopeType @default(GLOBAL) @map("scope_type")
  scopeKey     String            @default("GLOBAL") @map("scope_key") @db.VarChar(120)
  departmentId String?           @map("department_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")
  revokedAt    DateTime?         @map("revoked_at")

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  role       Role        @relation(fields: [roleId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId, scopeType, scopeKey])
  @@index([userId])
  @@index([roleId])
  @@index([departmentId])
  @@map("user_roles")
}

model ResourceAccessGrant {
  id           String       @id @default(uuid()) @db.Uuid
  resourceType ResourceType @map("resource_type")
  resourceId   String       @map("resource_id") @db.Uuid
  granteeType  GranteeType  @map("grantee_type")
  granteeId    String       @map("grantee_id") @db.Uuid
  grantType    GrantType    @map("grant_type")
  status       GrantStatus  @default(ACTIVE)
  startsAt     DateTime?    @map("starts_at")
  expiresAt    DateTime?    @map("expires_at")
  createdById  String?      @map("created_by_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  revokedAt    DateTime?    @map("revoked_at")

  @@index([resourceType, resourceId])
  @@index([granteeType, granteeId])
  @@index([status])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("resource_access_grants")
}

model Achievement {
  id            String            @id @default(uuid()) @db.Uuid
  type          AchievementType
  title         String            @db.VarChar(500)
  status        AchievementStatus @default(DRAFT)
  secretLevel   SecretLevel       @default(INTERNAL) @map("secret_level")
  departmentId  String            @map("department_id") @db.Uuid
  ownerUserId   String            @map("owner_user_id") @db.Uuid
  submittedById String?           @map("submitted_by_id") @db.Uuid
  createdById   String?           @map("created_by_id") @db.Uuid
  updatedById   String?           @map("updated_by_id") @db.Uuid
  archivedById  String?           @map("archived_by_id") @db.Uuid
  voidedById    String?           @map("voided_by_id") @db.Uuid
  version       Int               @default(1)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  submittedAt   DateTime?         @map("submitted_at")
  archivedAt    DateTime?         @map("archived_at")
  voidedAt      DateTime?         @map("voided_at")
  voidReason    String?           @map("void_reason") @db.Text

  department              Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  ownerUser               User                     @relation("AchievementOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  submittedBy             User?                    @relation("AchievementSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  paperDetail             PaperDetail?
  patentDetail            PatentDetail?
  softwareCopyrightDetail SoftwareCopyrightDetail?
  contributors            AchievementContributor[]
  feeRecords              FeeRecord[]

  @@index([departmentId, status])
  @@index([ownerUserId, status])
  @@index([type, status])
  @@index([secretLevel])
  @@map("achievements")
}

model PaperDetail {
  achievementId String   @id @map("achievement_id") @db.Uuid
  doi           String?  @db.VarChar(255)
  doiNormalized String?  @unique @map("doi_normalized") @db.VarChar(255)
  journal       String?  @db.VarChar(255)
  issnCn        String?  @map("issn_cn") @db.VarChar(64)
  publishYear   Int?     @map("publish_year")
  includedType  String?  @map("included_type") @db.VarChar(80)
  impactFactor  Decimal? @map("impact_factor") @db.Decimal(8, 3)
  partition     String?  @db.VarChar(80)
  abstract      String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@index([publishYear])
  @@index([journal])
  @@map("paper_details")
}

model PatentDetail {
  achievementId           String            @id @map("achievement_id") @db.Uuid
  applicationNo           String?           @map("application_no") @db.VarChar(120)
  applicationNoNormalized String?           @unique @map("application_no_normalized") @db.VarChar(120)
  grantNo                 String?           @map("grant_no") @db.VarChar(120)
  grantNoNormalized       String?           @unique @map("grant_no_normalized") @db.VarChar(120)
  patentType              PatentType?       @map("patent_type")
  filingDate              DateTime?         @map("filing_date") @db.Date
  grantDate               DateTime?         @map("grant_date") @db.Date
  nextFeeDate             DateTime?         @map("next_fee_date") @db.Date
  feeAmount               Decimal?          @map("fee_amount") @db.Decimal(12, 2)
  legalStatus             PatentLegalStatus @default(UNKNOWN) @map("legal_status")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@index([legalStatus])
  @@index([nextFeeDate])
  @@map("patent_details")
}

model SoftwareCopyrightDetail {
  achievementId            String        @id @map("achievement_id") @db.Uuid
  registrationNo           String?       @map("registration_no") @db.VarChar(120)
  registrationNoNormalized String?       @unique @map("registration_no_normalized") @db.VarChar(120)
  softwareVersion          String?       @map("software_version") @db.VarChar(80)
  softwareType             SoftwareType? @map("software_type")
  publishDate              DateTime?     @map("publish_date") @db.Date
  registerDate             DateTime?     @map("register_date") @db.Date
  runEnv                   String?       @map("run_env") @db.VarChar(255)
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)

  @@index([softwareType])
  @@index([registerDate])
  @@map("software_copyright_details")
}

model AchievementContributor {
  id              String           @id @default(uuid()) @db.Uuid
  achievementId   String           @map("achievement_id") @db.Uuid
  name            String           @db.VarChar(120)
  userId          String?          @map("user_id") @db.Uuid
  organization    String?          @db.VarChar(255)
  contributorType ContributorType  @map("contributor_type")
  contributorRole ContributorRole? @map("contributor_role")
  sortOrder       Int              @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([achievementId, contributorType, sortOrder])
  @@index([achievementId])
  @@index([userId])
  @@map("achievement_contributors")
}

model WorkflowInstance {
  id          String                 @id @default(uuid()) @db.Uuid
  targetType  WorkflowTargetType     @map("target_type")
  targetId    String                 @map("target_id") @db.Uuid
  status      WorkflowInstanceStatus @default(ACTIVE)
  currentStep String?                @map("current_step") @db.VarChar(80)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  completedAt DateTime?              @map("completed_at")
  cancelledAt DateTime?              @map("cancelled_at")

  tasks   WorkflowTask[]
  actions WorkflowAction[]

  @@index([targetType, targetId])
  @@index([targetType, targetId, status])
  @@index([status])
  @@map("workflow_instances")
}

model WorkflowTask {
  id          String             @id @default(uuid()) @db.Uuid
  instanceId  String             @map("instance_id") @db.Uuid
  assigneeId  String             @map("assignee_id") @db.Uuid
  stepCode    String             @map("step_code") @db.VarChar(80)
  status      WorkflowTaskStatus @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  claimedAt   DateTime?          @map("claimed_at")
  completedAt DateTime?          @map("completed_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  assignee User             @relation("WorkflowTaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  actions  WorkflowAction[]

  @@index([assigneeId, status])
  @@index([instanceId, status])
  @@map("workflow_tasks")
}

model WorkflowAction {
  id         String             @id @default(uuid()) @db.Uuid
  instanceId String             @map("instance_id") @db.Uuid
  taskId     String?            @map("task_id") @db.Uuid
  actorId    String             @map("actor_id") @db.Uuid
  action     WorkflowActionType
  comment    String?            @db.Text
  createdAt  DateTime           @default(now()) @map("created_at")

  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  task     WorkflowTask?    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor    User             @relation("WorkflowActionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([instanceId])
  @@index([actorId])
  @@index([createdAt])
  @@map("workflow_actions")
}

model FeeRecord {
  id            String      @id @default(uuid()) @db.Uuid
  achievementId String      @map("achievement_id") @db.Uuid
  departmentId  String      @map("department_id") @db.Uuid
  feeType       FeeType     @map("fee_type")
  fundSource    FundSource? @map("fund_source")
  amount        Decimal     @db.Decimal(12, 2)
  dueDate       DateTime    @map("due_date") @db.Date
  paidDate      DateTime?   @map("paid_date") @db.Date
  payStatus     PayStatus   @default(PENDING) @map("pay_status")
  voucherNo     String?     @map("voucher_no") @db.VarChar(120)
  reviewStatus  FeeReviewStatus @default(PENDING) @map("review_status")
  reviewedById  String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?   @map("reviewed_at")
  createdById   String?     @map("created_by_id") @db.Uuid
  updatedById   String?     @map("updated_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  archivedAt    DateTime?   @map("archived_at")

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Restrict)
  department  Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  reviewedBy  User?       @relation("FeeReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewHistory FeeReviewHistory[]

  @@unique([achievementId, feeType, dueDate])
  @@index([dueDate, payStatus])
  @@index([reviewStatus])
  @@index([reviewedById])
  @@index([achievementId])
  @@index([departmentId])
  @@map("fee_records")
}

model FeeReviewHistory {
  id           String                 @id @default(uuid()) @db.Uuid
  feeRecordId  String                 @map("fee_record_id") @db.Uuid
  departmentId String                 @map("department_id") @db.Uuid
  reviewerId   String                 @map("reviewer_id") @db.Uuid
  action       FeeReviewHistoryAction
  fromStatus   FeeReviewStatus        @map("from_status")
  toStatus     FeeReviewStatus        @map("to_status")
  reason       String?                @db.VarChar(500)
  createdAt    DateTime               @default(now()) @map("created_at")

  feeRecord  FeeRecord  @relation(fields: [feeRecordId], references: [id], onDelete: Restrict)
  department Department @relation("FeeReviewHistoryDepartment", fields: [departmentId], references: [id], onDelete: Restrict)
  reviewer   User       @relation("FeeReviewHistoryReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([feeRecordId, createdAt])
  @@index([departmentId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("fee_review_history")
}

model ReminderTask {
  id          String             @id @default(uuid()) @db.Uuid
  targetType  ReminderTargetType @map("target_type")
  targetId    String             @map("target_id") @db.Uuid
  remindDate  DateTime           @map("remind_date") @db.Date
  remindLevel ReminderLevel      @map("remind_level")
  receiverId  String             @map("receiver_id") @db.Uuid
  status      ReminderStatus     @default(PENDING)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  sentAt      DateTime?          @map("sent_at")
  confirmedAt DateTime?          @map("confirmed_at")

  receiver User @relation("ReminderReceiver", fields: [receiverId], references: [id], onDelete: Restrict)

  @@unique([targetType, targetId, remindDate, remindLevel, receiverId])
  @@index([receiverId, status])
  @@index([remindDate, status])
  @@map("reminder_tasks")
}

model Notification {
  id         String              @id @default(uuid()) @db.Uuid
  receiverId String              @map("receiver_id") @db.Uuid
  channel    NotificationChannel
  title      String              @db.VarChar(255)
  content    String              @db.Text
  status     NotificationStatus  @default(PENDING)
  createdAt  DateTime            @default(now()) @map("created_at")
  sentAt     DateTime?           @map("sent_at")
  readAt     DateTime?           @map("read_at")

  receiver User @relation("NotificationReceiver", fields: [receiverId], references: [id], onDelete: Restrict)

  @@index([receiverId, status])
  @@index([channel, status])
  @@map("notifications")
}

model Attachment {
  id              String                 @id @default(uuid()) @db.Uuid
  relationType    AttachmentRelationType @map("relation_type")
  relationId      String                 @map("relation_id") @db.Uuid
  fileName        String                 @map("file_name") @db.VarChar(255)
  storageKey      String                 @map("storage_key") @db.VarChar(500)
  mimeType        String?                @map("mime_type") @db.VarChar(127)
  sizeBytes       Int?                   @map("size_bytes")
  storageProvider String?                @default("LOCAL_DISK") @map("storage_provider") @db.VarChar(32)
  originalName    String?                @map("original_name") @db.VarChar(255)
  storedName      String?                @map("stored_name") @db.VarChar(255)
  version         Int                    @default(1)
  uploaderId      String                 @map("uploader_id") @db.Uuid
  secretLevel     SecretLevel            @default(INTERNAL) @map("secret_level")
  checksum        String?                @db.VarChar(128)
  status          AttachmentStatus       @default(ACTIVE)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  archivedAt      DateTime?              @map("archived_at")

  uploader User @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: Restrict)

  @@unique([relationType, relationId, fileName, version])
  @@index([relationType, relationId])
  @@index([uploaderId])
  @@index([secretLevel])
  @@map("attachments")
}

model AuditLog {
  id                 String          @id @default(uuid()) @db.Uuid
  actorUserId        String?         @map("actor_user_id") @db.Uuid
  actorDepartmentId  String?         @map("actor_department_id") @db.Uuid
  action             AuditActionType
  targetType         String          @map("target_type") @db.VarChar(100)
  targetId           String?         @map("target_id") @db.Uuid
  targetDepartmentId String?         @map("target_department_id") @db.Uuid
  targetSecretLevel  SecretLevel?    @map("target_secret_level")
  oldValue           Json?           @map("old_value")
  newValue           Json?           @map("new_value")
  ipAddress          String?         @map("ip_address") @db.VarChar(64)
  userAgent          String?         @map("user_agent") @db.Text
  traceId            String?         @map("trace_id") @db.VarChar(120)
  createdAt          DateTime        @default(now()) @map("created_at")

  actorUser       User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  actorDepartment Department? @relation("AuditDepartment", fields: [actorDepartmentId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([traceId])
  @@map("audit_logs")
}

model ImportJob {
  id                    String          @id @default(uuid()) @db.Uuid
  idempotencyKeyHash    String          @map("idempotency_key_hash") @db.VarChar(128)
  importFamily          ImportFamily    @map("import_family")
  mode                  ImportMode
  achievementType       AchievementType? @map("achievement_type")
  targetEnvironment     String          @map("target_environment") @db.VarChar(64)
  scopeType             String          @map("scope_type") @db.VarChar(64)
  scopeHash             String          @map("scope_hash") @db.VarChar(128)
  fileFingerprint       String          @map("file_fingerprint") @db.VarChar(128)
  fileSizeBytes         Int?            @map("file_size_bytes")
  operatorUserId        String?         @map("operator_user_id") @db.Uuid
  status                ImportJobStatus @default(PENDING)
  latestRunId           String?         @map("latest_run_id") @db.Uuid
  acceptedRowCount      Int             @default(0) @map("accepted_row_count")
  createdBusinessCount  Int             @default(0) @map("created_business_count")
  createdCompanionCount Int             @default(0) @map("created_companion_count")
  auditCount            Int             @default(0) @map("audit_count")
  warningCount          Int             @default(0) @map("warning_count")
  errorCount            Int             @default(0) @map("error_count")
  safeErrorCodes        Json?           @map("safe_error_codes")
  safeSummary           Json?           @map("safe_summary")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  completedAt           DateTime?       @map("completed_at")

  runs  ImportRun[]
  items ImportJobItem[]

  @@unique([targetEnvironment, scopeType, scopeHash, idempotencyKeyHash])
  @@index([importFamily, mode, status])
  @@index([operatorUserId, createdAt])
  @@index([createdAt])
  @@index([completedAt])
  @@index([latestRunId])
  @@map("import_jobs")
}

model ImportRun {
  id                             String              @id @default(uuid()) @db.Uuid
  jobId                          String              @map("job_id") @db.Uuid
  attemptNo                      Int                 @map("attempt_no")
  trigger                        ImportRunTrigger    @default(INITIAL_SUBMIT)
  status                         ImportRunStatus     @default(PENDING)
  operatorUserId                 String?             @map("operator_user_id") @db.Uuid
  requestFingerprint             String?             @map("request_fingerprint") @db.VarChar(128)
  validationSummary              Json?               @map("validation_summary")
  applySummary                   Json?               @map("apply_summary")
  failureCode                    String?             @map("failure_code") @db.VarChar(120)
  failureStage                   ImportFailureStage? @map("failure_stage")
  auditLogIds                    Json?               @map("audit_log_ids")
  completedBusinessTransactionAt DateTime?           @map("completed_business_transaction_at")
  startedAt                      DateTime?           @map("started_at")
  finishedAt                     DateTime?           @map("finished_at")
  createdAt                      DateTime            @default(now()) @map("created_at")
  updatedAt                      DateTime            @updatedAt @map("updated_at")

  job   ImportJob      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  items ImportJobItem[]

  @@unique([jobId, attemptNo])
  @@index([jobId, status])
  @@index([operatorUserId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([finishedAt])
  @@map("import_runs")
}

model ImportJobItem {
  jobId         String                     @map("job_id") @db.Uuid
  runId         String                     @map("run_id") @db.Uuid
  rowNumber     Int                        @map("row_number")
  plannedAction ImportJobItemPlannedAction @map("planned_action")
  status        ImportJobItemStatus        @default(PENDING)
  safeCode      String?                    @map("safe_code") @db.VarChar(120)
  targetType    ImportJobItemTargetType    @map("target_type")
  targetId      String?                    @map("target_id") @db.Uuid

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  run ImportRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@id([runId, rowNumber])
  @@index([jobId])
  @@index([runId])
  @@index([jobId, rowNumber])
  @@index([status])
  @@index([safeCode])
  @@index([targetType])
  @@map("import_job_items")
}

model ApiIntegration {
  id         String                 @id @default(uuid()) @db.Uuid
  code       String                 @unique @db.VarChar(100)
  provider   ApiIntegrationProvider
  enabled    Boolean                @default(false)
  timeoutMs  Int                    @default(3000) @map("timeout_ms")
  configRef  String?                @map("config_ref") @db.VarChar(255)
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  archivedAt DateTime?              @map("archived_at")

  callLogs ApiCallLog[]

  @@index([enabled])
  @@index([provider])
  @@map("api_integrations")
}

model ApiCallLog {
  id              String        @id @default(uuid()) @db.Uuid
  integrationCode String        @map("integration_code") @db.VarChar(100)
  requestId       String        @unique @map("request_id") @db.VarChar(120)
  status          ApiCallStatus
  durationMs      Int?          @map("duration_ms")
  errorSummary    String?       @map("error_summary") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  integration ApiIntegration @relation(fields: [integrationCode], references: [code], onDelete: Restrict)

  @@index([integrationCode, createdAt])
  @@index([status])
  @@map("api_call_logs")
}

model SearchLog {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  keyword     String?  @db.Text
  filters     Json?
  resultCount Int      @default(0) @map("result_count")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("search_logs")
}
