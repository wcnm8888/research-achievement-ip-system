# Copy this file to .env.demo on the VPS and fill demo/staging values there.
# Do not commit .env.demo or any real password/token/connection string.

POSTGRES_DB=replace_with_demo_database_name
POSTGRES_USER=replace_with_demo_database_user
POSTGRES_PASSWORD=replace_with_strong_demo_database_password

DATABASE_URL=replace_with_postgres_connection_url_for_the_compose_network
PORT=3000
NODE_ENV=staging

# Keep /api for same-origin access through demo.wangyimin.cn.
VITE_API_BASE_URL=/api

