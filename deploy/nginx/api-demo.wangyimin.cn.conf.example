# Baota/Nginx site example for api-demo.wangyimin.cn.
# Configure SSL in Baota. This endpoint is intended for demo/staging readonly
# smoke checks, not production traffic.

server {
    listen 80;
    server_name api-demo.wangyimin.cn;

    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:13000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}

