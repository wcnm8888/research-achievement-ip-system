# Production environment template
#
# Do not commit real production values.
# Do not paste real secrets, passwords, cookies, tokens, certificates, private keys,
# or full connection strings into chat, tickets, docs, logs, screenshots, or commits.

NODE_ENV=production
PORT=3000

POSTGRES_DB=<PRODUCTION_DATABASE_NAME>
POSTGRES_USER=<PRODUCTION_DATABASE_USER>
POSTGRES_PASSWORD=<GENERATED_ON_VPS>
DATABASE_URL=<VPS_LOCAL_DATABASE_URL_FOR_COMPOSE_NETWORK>

SESSION_SECRET=<GENERATED_ON_VPS>
AUTH_BOOTSTRAP_ENABLED=false
CORS_ALLOWED_ORIGIN=https://production.wangyimin.cn
VITE_API_BASE_URL=/api
LOG_LEVEL=info

# Account lifecycle delivery
#
# Safe default keeps email delivery local/no-send:
# ACCOUNT_LIFECYCLE_DELIVERY_PROVIDER=local_stub
#
# Local production-like DirectMail acceptance may use the following names only
# after the user manually provides a private .env.production file outside git.
ACCOUNT_LIFECYCLE_DELIVERY_PROVIDER=local_stub
ALIYUN_DM_DRY_RUN=true
ALIYUN_DM_ACCOUNT_NAME=system@wzunew.uk
ALIYUN_DM_FROM_ALIAS=科研成果管理系统
ALIYUN_DM_REGION=cn-hangzhou
ALIBABA_CLOUD_ACCESS_KEY_ID=<SET_OUTSIDE_REPO>
ALIBABA_CLOUD_ACCESS_KEY_SECRET=<SET_OUTSIDE_REPO>

# Notes:
# - PORT is the API container port. docker-compose.production.yml maps host
#   127.0.0.1:13001 to container port 3000.
# - POSTGRES_PASSWORD, SESSION_SECRET, and DATABASE_URL must be generated and
#   stored only on the VPS.
# - AUTH_BOOTSTRAP_ENABLED may be set to true only during the first-admin
#   initialization window, then must be set back to false immediately.
# - Production uses same-origin /api through https://production.wangyimin.cn.
# - Keep ACCOUNT_LIFECYCLE_DELIVERY_PROVIDER=local_stub and ALIYUN_DM_DRY_RUN=true
#   unless a later Step explicitly authorizes DirectMail sending.
# - Never commit the real .env.production file.
